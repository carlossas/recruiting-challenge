# Copy to .env (`npm run setup:env` does it for you). .env is gitignored.

# Secret used to sign session JWTs (HS256).
# Left empty here: a local start generates one and appends it to .env.
JWT_SECRET=

# HTTP port of the dashboard server.
PORT=3000

# SQLite database file.
DB_PATH=data/dashboard.db

# Lifetime of the admin (mint-scoped) token.
ADMIN_TOKEN_TTL=8h

# Lifetime of the merchant (data-scoped) token minted on every merchant switch.
MERCHANT_TOKEN_TTL=10m

# Set to "off" to stop handing admin session cookies to local requests
# (useful to exercise the real 401 flow).
DEV_ADMIN_SESSION=on
