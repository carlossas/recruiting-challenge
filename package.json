{
  "name": "recruiting-challenge",
  "version": "0.1.0",
  "private": true,
  "description": "Engineering recruiting challenge — small merchant sales dashboard.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "seed": "tsx src/scripts/seed.ts",
    "test": "cross-env DB_PATH=:memory: node --import tsx --test test/**/*.test.ts",
    "build": "tsc",
    "check:deps": "tsx src/scripts/check-deps.ts",
    "token": "tsx src/scripts/issue-token.ts",
    "setup:env": "tsx src/scripts/setup-env.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "express": "^4.21.0",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.0",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "express": {
      "qs": "^6.16.0"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
